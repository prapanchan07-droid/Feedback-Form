# Gemini API Settings
#GEMINI_API_KEY=your_gemini_api_key_here
#GEMINI_MODEL=gemini-2.5-flash

#Qwen API Settings
GEMINI_API_KEY=QWEN_API_KEY
GEDMINI_MODEL=Qwen: Qwen3 VL 235B A22B Instruct

# Database Settings
DATABASE_URL=sqlite:///./app.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/form_extraction_db

# Task Queue & Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage

# AWS S3 (Optional Production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ML Thresholds & Paths
CNN_MODEL_PATH=./ml/models/pretrained_resnet18.pth
CNN_CONFIDENCE_THRESHOLD=0.85
CUTOFF_MIN=0.0
CUTOFF_MAX=200.0

MAX_UPLOAD_SIZE_MB=25
